{
  "formId": "F1040",
  "formVersion": "2024",
  "title": "U.S. Individual Income Tax Return — Page 1 (excerpt)",
  "pages": [
    { "number": 1, "width": 612, "height": 792, "unit": "pt" }
  ],
  "fields": [
    {
      "id": "taxYear",
      "formLine": "1040 Header",
      "description": "Printed tax year — static, not sourced from taxpayer data.",
      "page": 1,
      "position": { "x": 36, "y": 40, "width": 60, "height": 16, "unit": "pt" },
      "format": { "type": "text", "alignment": "left" },
      "dataBinding": { "literal": "2024" }
    },
    {
      "id": "taxpayerName",
      "formLine": "1040 Name line",
      "description": "Primary taxpayer full name.",
      "page": 1,
      "position": { "x": 36, "y": 90, "width": 260, "height": 16, "unit": "pt" },
      "format": { "type": "text", "alignment": "left" },
      "dataBinding": { "path": "$.primaryTaxpayer.firstName" }
    },
    {
      "id": "taxpayerSsn",
      "formLine": "1040 SSN box",
      "page": 1,
      "position": { "x": 468, "y": 90, "width": 108, "height": 16, "unit": "pt" },
      "format": { "type": "ssn", "alignment": "right" },
      "dataBinding": { "path": "$.primaryTaxpayer.ssn" }
    },
    {
      "id": "mfjCheckbox",
      "formLine": "1040 Filing status — Married filing jointly",
      "page": 1,
      "position": { "x": 200, "y": 120, "width": 12, "height": 12, "unit": "pt" },
      "format": { "type": "checkbox", "checkboxMark": "X" },
      "dataBinding": { "literal": true },
      "conditional": { "showIf": "@.filingStatus == 'marriedFilingJointly'" }
    },
    {
      "id": "line1a",
      "formLine": "1040 Line 1a",
      "description": "Total amount from Form(s) W-2, box 1, summed across every employer.",
      "page": 1,
      "position": { "x": 468, "y": 214, "width": 92, "height": 14, "unit": "pt" },
      "format": { "type": "currency", "decimalPlaces": 0, "negativeStyle": "parentheses" },
      "dataBinding": { "path": "$.income.w2Forms[*].box1Wages", "aggregate": "sum", "transform": "round" }
    },
    {
      "id": "line25a",
      "formLine": "1040 Line 25a",
      "description": "Federal income tax withheld per Form(s) W-2, box 2, summed.",
      "page": 1,
      "position": { "x": 468, "y": 402, "width": 92, "height": 14, "unit": "pt" },
      "format": { "type": "currency", "decimalPlaces": 0 },
      "dataBinding": { "path": "$.income.w2Forms[*].box2FederalTaxWithheld", "aggregate": "sum", "transform": "round" }
    },
    {
      "id": "caWagesOnly",
      "formLine": "Example filter — CA-sourced wages only",
      "description": "Demonstrates a filter predicate: wages from CA employers only.",
      "page": 1,
      "position": { "x": 468, "y": 430, "width": 92, "height": 14, "unit": "pt" },
      "format": { "type": "currency", "decimalPlaces": 0 },
      "dataBinding": { "path": "$.income.w2Forms[?(@.employerState=='CA')].box1Wages", "aggregate": "sum" }
    },
    {
      "id": "schB_interest_row",
      "formLine": "Schedule B Part I — interest payer row (template)",
      "description": "Repeats once per interest payer; each instance offsets 16pt down from the previous.",
      "page": 1,
      "position": { "x": 72, "y": 520, "width": 300, "height": 14, "unit": "pt" },
      "format": { "type": "text", "alignment": "left" },
      "dataBinding": { "path": "@.payerName" },
      "repeat": { "over": "$.income.interestPayers[*]", "rowHeight": 16, "maxRows": 4, "overflowFormId": "F1040-SchB-Cont" }
    },
    {
      "id": "schB_interest_amount_row",
      "formLine": "Schedule B Part I — interest amount row (template)",
      "page": 1,
      "position": { "x": 468, "y": 520, "width": 92, "height": 14, "unit": "pt" },
      "format": { "type": "currency", "decimalPlaces": 2, "negativeStyle": "parentheses" },
      "dataBinding": { "path": "@.amount" },
      "repeat": { "over": "$.income.interestPayers[*]", "rowHeight": 16, "maxRows": 4, "overflowFormId": "F1040-SchB-Cont" }
    }
  ]
}
